# Kian AI — serverless proxy credentials.
# Copy to `.env` (or set these in your Vercel project settings) and fill in
# ONLY the providers you use. Leave a value blank to disable that provider.
# NEVER commit a real key, and NEVER put one in the client bundle — a key in
# the browser is public.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: your site URL / name sent to OpenRouter (some free models require
# an HTTP-Referer header to be set).
OPENROUTER_REFERER=
